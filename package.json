{
  "name": "driveos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "agent:build": "npm run build --workspace=apps/agent",
    "agent:help": "node apps/agent/dist/index.js --help",
    "agent:start": "npm start --workspace=apps/agent",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "test": "npm test --workspace=packages/shared && npm test --workspace=apps/agent"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.93",
    "@convex-dev/rate-limiter": "^0.3.2",
    "convex": "^1.40.0"
  }
}
